# Runtime identity (Preview only in worktrees, CI and pull-request deployments)
APP_BASE_URL=http://127.0.0.1:3000
APP_ENVIRONMENT=preview
APP_EXPECTED_GIT_BRANCH=agent/t00-issue-000
APP_EXPECTED_SUPABASE_PROJECT_REF=replace_with_preview_project_ref
GIT_BRANCH=agent/t00-issue-000
GITHUB_PR_NUMBER=000
# Comma-separated exact addresses or @domains. Keep this synthetic/allowlisted.
PREVIEW_AUTH_EMAIL_ALLOWLIST=@example.com
SUPABASE_BRANCH_NAME=agent/t00-issue-000

# Public credentials from that same Supabase Preview Branch
NEXT_PUBLIC_SUPABASE_URL=https://replace_with_preview_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ephemeral Preview-only credential used by the black-box fixture harness
# Never expose this variable to the browser or source it from the main project.
SUPABASE_SERVICE_ROLE_KEY=
